# ==========================================
# ProxiSpeak Backend - Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Firebase Core Configuration
FIREBASE_PROJECT_ID=proxispeak-dev
FIREBASE_STORAGE_BUCKET=proxispeak-dev.appspot.com

# Firebase Authentication Credentials (Choose one method):
# 1. Path to local service account JSON file:
FIREBASE_SERVICE_ACCOUNT_PATH=
# 2. Base64-encoded or raw JSON string of the service account:
FIREBASE_SERVICE_ACCOUNT_KEY=
# 3. If neither is specified, Firebase Admin SDK will use Application Default Credentials (ADC) or Emulator.

# Firebase Emulator Suite (Set to true when running local Firebase emulators)
USE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Geospatial Discovery Rules (meters)
DEFAULT_DISCOVERY_RADIUS_METERS=5000
MAX_DISCOVERY_RADIUS_METERS=50000
DEFAULT_DISCOVERY_PAGE_LIMIT=20
MAX_DISCOVERY_PAGE_LIMIT=100

# Audio Upload & Storage Settings
# 10 MB = 10 * 1024 * 1024 = 10485760 bytes
MAX_AUDIO_FILE_SIZE_BYTES=10485760
# Expiration time for signed download/playback URLs (seconds, default: 15 minutes)
PLAYBACK_URL_EXPIRY_SECONDS=900
# Expiration time for signed upload URLs (seconds, default: 15 minutes)
UPLOAD_URL_EXPIRY_SECONDS=900

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_DISCOVERY_MAX_REQUESTS=30

# Logging
LOG_LEVEL=info
