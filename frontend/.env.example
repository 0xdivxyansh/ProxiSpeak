# ProxiSpeak Frontend Environment Variables

# Backend API Base URL (empty uses Vite proxy /api/v1)
VITE_API_BASE_URL=

# Firebase Client Configuration (Optional for production auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=proxispeak-dev
VITE_FIREBASE_STORAGE_BUCKET=proxispeak-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
